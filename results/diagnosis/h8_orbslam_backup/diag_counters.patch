+// --- External CNN/ViT loop closure candidate injection ---
+
+void LoopClosing::SetExternalCandidateSubscriber(ros::NodeHandle& nh)
+{
+    mExternalCandSub = nh.subscribe("/loop_closure/candidate_kfids", 1,
+                                     &LoopClosing::ExternalCandidateCallback, this);
+    cout << "LoopClosing: subscribed to /loop_closure/candidate_kfids" << endl;
+}
+
+void LoopClosing::ExternalCandidateCallback(const std_msgs::Int32MultiArray::ConstPtr& msg)
+{
+    // Expected: data = [current_kf_id, candidate_kf_id]
+    if(msg->data.size() != 2)
+        return;
+
+    unique_lock<mutex> lock(mMutexExternalCand);
+    mExternalCandQueue.push_back(
+        std::make_pair((long unsigned int)msg->data[0],
+                       (long unsigned int)msg->data[1]));
+    cout << "[DIAG] recv cur=" << msg->data[0] << " cand=" << msg->data[1] << " q=" << mExternalCandQueue.size() << endl;
+
+    // bound the queue so a stalled consumer can't grow it without limit
+    while(mExternalCandQueue.size() > 50)
+    {
+        cout << "[DIAG] drop=cap cand=" << mExternalCandQueue.front().second << endl;
+        mExternalCandQueue.pop_front();
+    }
+}
+
+KeyFrame* LoopClosing::GetKeyFrameById(long unsigned int id)
+{
+    const vector<KeyFrame*> vpAllKFs = mpAtlas->GetAllKeyFrames();
+    for(KeyFrame* pKF : vpAllKFs)
+    {
+        if(pKF && pKF->mnId == id && !pKF->isBad())
+            return pKF;
+    }
+    return nullptr;
+}
